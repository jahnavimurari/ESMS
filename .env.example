# ==============================================================================
# Employee Success Management System (ESMS) - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file with real credentials to version control.
# ==============================================================================

# Application Environment (development, testing, production)
FLASK_ENV=development
FLASK_APP=run.py
FLASK_DEBUG=1
PORT=5000

# Secret Keys (Generate cryptographically secure random keys for production)
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars
JWT_SECRET_KEY=replace-with-a-secure-random-jwt-secret-key-min-32-chars
JWT_ACCESS_TOKEN_EXPIRES_HOURS=8

# ------------------------------------------------------------------------------
# Neon Serverless PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Pooled connection string (recommended for API runtime / pgBouncer):
# Format: postgresql+psycopg://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require
DATABASE_URL=postgresql+psycopg://YOUR_NEON_USERNAME:YOUR_NEON_PASSWORD@YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require

# Direct connection string (recommended for running Alembic migrations):
# Format: postgresql+psycopg://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require
DATABASE_DIRECT_URL=postgresql+psycopg://YOUR_NEON_USERNAME:YOUR_NEON_PASSWORD@YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require

# Frontend Client URL (for CORS whitelisting)
FRONTEND_URL=http://localhost:5173

